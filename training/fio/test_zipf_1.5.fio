# Block-IO region sweep for Cox training data collection.
# 20 concurrent regions on /dev/nvme0n1, numjobs=1 each, rwmixwrite 100→20.
#
# Region layout (% of namespace capacity):
#   - offset (per job, fixed): 0%, 5%, 10%, …, 95%  (20 anchor points)
#   - size (fixed): IO span = [offset, offset+5%) — full device coverage
#
# Skew phase: zipf:1.5 (hot/cold within each 5% region band).
# zipf θ↑ → fewer LBAs get most writes (hotter revisit within the 5% band)
#
# Paired with run_fio_with_training.sh → out_skew_zipf15.
# Each phase: drop_caches + erase-only precondition → rest → 35min fio (~7 x 300s windows).

[global]
filename=/dev/nvme0n1
ioengine=io_uring
direct=1
numjobs=1
iodepth=64
bs=4K
size=5%
random_distribution=zipf:1.5
time_based=1
runtime=2100
group_reporting=1

[region-00]
offset=0%
rw=randrw
rwmixwrite=100

[region-01]
offset=5%
rw=randrw
rwmixwrite=96

[region-02]
offset=10%
rw=randrw
rwmixwrite=92

[region-03]
offset=15%
rw=randrw
rwmixwrite=87

[region-04]
offset=20%
rw=randrw
rwmixwrite=83

[region-05]
offset=25%
rw=randrw
rwmixwrite=79

[region-06]
offset=30%
rw=randrw
rwmixwrite=75

[region-07]
offset=35%
rw=randrw
rwmixwrite=71

[region-08]
offset=40%
rw=randrw
rwmixwrite=66

[region-09]
offset=45%
rw=randrw
rwmixwrite=62

[region-10]
offset=50%
rw=randrw
rwmixwrite=58

[region-11]
offset=55%
rw=randrw
rwmixwrite=54

[region-12]
offset=60%
rw=randrw
rwmixwrite=49

[region-13]
offset=65%
rw=randrw
rwmixwrite=45

[region-14]
offset=70%
rw=randrw
rwmixwrite=41

[region-15]
offset=75%
rw=randrw
rwmixwrite=37

[region-16]
offset=80%
rw=randrw
rwmixwrite=33

[region-17]
offset=85%
rw=randrw
rwmixwrite=28

[region-18]
offset=90%
rw=randrw
rwmixwrite=24

[region-19]
offset=95%
rw=randrw
rwmixwrite=20
